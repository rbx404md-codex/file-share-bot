# ── RBX404 Digital File Platform — environment template ──
# Copy this file to .env for local runs. On Railway, set these as
# Variables in the service settings instead of committing a .env file.

# Get this from @BotFather. NEVER commit the real value.
BOT_TOKEN=8972144584:AAHrZRIUoDBAlHqejj31Zr4xLO8vW7paGM4

# Comma-separated Telegram user IDs allowed to use /admin and the admin Mini App.
ADMIN_IDS=7294948308

# Private channel the bot forwards uploaded files into for storage.
# The bot must be an admin of this channel. Use a numeric id like -1001234567890.
FILE_CHANNEL=-1004291342703

# Optional: separate channel for admin activity logs. Leave blank to disable.
LOG_CHANNEL=-1004291342703

# Optional: channel where /backup dumps are also posted. Defaults to FILE_CHANNEL.
BACKUP_CHANNEL=-1004291342703

# Where the SQLite database file lives.
DATABASE_PATH=data/rbx404.db

# Public base URL the Mini App and share pages are served from.
# Leave BLANK on Railway — it is auto-detected from RAILWAY_PUBLIC_DOMAIN.
# Only set this manually for local tunnels (ngrok/cloudflared) or a custom domain.
BASE_URL=

# Port the web server binds to. Railway sets this automatically — leave blank there.
PORT=8080

# Secret used to sign admin/session-sensitive actions. Generate any long random string.
SIGNING_SECRET=

BRAND_NAME=RBX404
BRAND_TITLE=RBX404 Digital File Platform
DEFAULT_LANGUAGE=bn

ENABLE_MINI_APP=true
ENABLE_QR=true
ENABLE_FORCE_JOIN=true

TRASH_RETENTION_DAYS=7
DEFAULT_AUTO_DELETE_MINUTES=0
